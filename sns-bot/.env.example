# shikaku-wiki SNS bot 設定（ローカル検証用・認証情報は含めない）
# 本番（GitHub Actions）では認証情報を Secret Gist から読むため、このファイルは
# ローカルで非秘密の設定のみ使う。

# 認証情報の代わりにローカルファイルを使う場合（Gitignore 済み）
LOCAL_CRED_FILE=sns-bot/.credentials.local.json

# Threads トークンのリフレッシュ判定（デフォルト: 10日）
# REFRESH_BEFORE_DAYS=10

# キャンペーン機能（fetchCampaigns 用・任意）
# TAVILY_API_KEY=
# GEMINI_API_KEY=
